{
  "name": "fed-catalogo-compara-precos",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint && stylelint \"src/**/*.scss\" --allow-empty-input",
    "lint:styles": "stylelint \"src/**/*.scss\" --allow-empty-input",
    "format": "prettier --write .",
    "test:ci": "ng test --watch=false --coverage",
    "e2e": "playwright test",
    "contraste": "node scripts/contraste.mjs",
    "deploy:rules:dev": "firebase deploy --only firestore:rules,firestore:indexes -P dev",
    "deploy:functions:dev": "firebase deploy --only functions -P dev"
  },
  "private": true,
  "packageManager": "npm@10.9.3",
  "dependencies": {
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "^22.2.0",
    "barcode-detector": "^3.2.2",
    "firebase": "^12.19.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^5.0.2",
    "angular-eslint": "22.5.0",
    "eslint": "^10.9.1",
    "firebase-tools": "^15.31.0",
    "http-server": "^14.1.1",
    "jsdom": "^30.0.0",
    "lighthouse": "^12.8.2",
    "node": "^22.23.3",
    "prettier": "^3.8.1",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.22.3"
  }
}
